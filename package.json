{
  "name": "uiv-language",
  "displayName": "UIV / UT",
  "description": "Unit Informed Values and Unit Types syntax highlighting",
  "version": "0.0.4",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "uiv",
        "aliases": ["UIV", "UT", "Unit Types", "Unit Informed Values"],
        "extensions": [".uiv", ".ut"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "uiv",
        "scopeName": "source.uiv",
        "path": "./syntaxes/uiv.tmLanguage.json"
      }
    ]
  }
}