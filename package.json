{
  "name": "uiv",
  "publisher": "wgbowley",
  "displayName": "UIV / UT",
  "description": "Unit Informed Values and Unit Types syntax highlighting",
  "version": "0.0.6",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "ut",
        "aliases": ["Unit Types", "UT"],
        "extensions": [".ut"],
        "configuration": "./format/language-configuration.json"
      },
      {
        "id": "uiv",
        "aliases": ["Unit Informed Values", "UIV"],
        "extensions": [".uiv"],
        "configuration": "./format/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ut",
        "scopeName": "source.ut",
        "path": "./syntaxes/ut.tmLanguage.json"
      },
      {
        "language": "uiv",
        "scopeName": "source.uiv",
        "path": "./syntaxes/uiv.tmLanguage.json"
      }
    ]
  }
}