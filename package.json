{
  "name": "UnitValues",
  "publisher": "wgbowley",
  "displayName": "UnitValues",
  "description": "UnitValues Syntax Highlighting",
  "version": "0.0.1",
  "icon": "./media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },

  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ut",
        "aliases": ["Unit Types", "UT"],
        "extensions": [".ut"],
        "configuration": "./config/ut-configuration.json"
      },
      {
        "id": "uiv",
        "aliases": ["Unit Informed Values", "UIV"],
        "extensions": [".uiv"],
        "configuration": "./config/uiv-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ut",
        "scopeName": "source.ut",
        "path": "./syntaxes/ut.tmLanguage.json"
      },
      {
        "language": "uiv",
        "scopeName": "source.uiv",
        "path": "./syntaxes/uiv.tmLanguage.json"
      }
    ],

    "iconThemes": [
      {
        "id": "unitvalues",
        "label": "UnitValues",
        "path": "./fileicons/icon-theme.json"
      }
    ]
  },

  "repository": {
    "type": "git",
    "url": "https://github.com/Bowley-Systems/UnitValues"
  }
}