{
  "scopeName": "source.ut",
  "patterns": [
    { "include": "#section" },
    { "include": "#unit_definition" },
    { "include": "#comment" }
  ],
  "repository": {
    "section": {
      "patterns": [
        {
          "name": "entity.name.section.ut",
          "match": "\\[[A-Za-z0-9_.]+\\]"
        }
      ]
    },
    "unit_definition": {
      "patterns": [
        {
          "match": "^\\s*([a-zA-ZΑ-Ωα-ωρσ_][a-zA-Z0-9_]*)\\s*:\\s*(.*)$",
          "captures": {
            "1": { "name": "entity.other.unit-symbol.ut" },
            "2": { 
              "patterns": [
                { "include": "#math_operator" },
                { "include": "#exponent" },
                { "include": "#number" },
                { "include": "#dimension_symbol" }
              ]
            }
          }
        }
      ]
    },
    "dimension_symbol": {
      "patterns": [
        {
          "name": "support.type.primitive.ut",
          "match": "\\b[A-Za-zΑ-Ωα-ω]+\\b"
        }
      ]
    },
    "math_operator": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.ut",
          "match": "[*^]"
        }
      ]
    },
    "exponent": {
      "patterns": [
        {
          "name": "constant.numeric.exponent.ut",
          "match": "\\-[0-9]+"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.ut",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.ut",
          "match": "#.*$"
        }
      ]
    }
  }
}